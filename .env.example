# Copia este archivo a .env.local y completa los valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor (secret / service_role). Nunca con prefijo NEXT_PUBLIC_.
# Es la única clave secreta del entorno: con ella el servidor lee los secretos
# cifrados (Supabase Vault) de las integraciones.
SUPABASE_SECRET_KEY=

# Google Tag Manager, GA4, Google Ads, píxel de Meta, WhatsApp Business,
# conversiones offline y la clave de tareas programadas se configuran desde el
# portal: /portal/integraciones (solo administradores). Las variables antiguas
# (NEXT_PUBLIC_GTM_ID, WHATSAPP_ACCESS_TOKEN, ADS_FEED_USER, CRON_SECRET…)
# siguen funcionando como respaldo si el valor no está guardado en el portal.
